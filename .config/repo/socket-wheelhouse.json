{
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "bundle": {
    "ref": "fleet-pack-011e1c67ce8860fdf7dca52a45e1a8d6620379e6",
    "cascadeSha": "011e1c67ce8860fdf7dca52a45e1a8d6620379e6"
  },
  "repoName": "action",
  "ai": {
    "localAssist": true
  },
  "repo": {
    "type": "solo"
  },
  "build": {
    "from": "github-action",
    "type": "js"
  },
  "release": {
    "versionSource": "package.json"
  },
  "fuzz": {
    "exempt": true,
    "reason": "The action parses no untrusted input. Every value it handles is either a workflow-author-supplied `with:` input that it passes straight to a GitHub API call or a subprocess argument, or a JSON report the Socket Firewall binary wrote in the same job. The only pure logic is two `<platform>-<arch>` lookup tables, whose whole input domain is the finite set of values Node reports for `process.platform`/`process.arch` — test/unit/tools/*.test.mts enumerates it exhaustively, so a coverage-guided vitiate lane has nothing left to explore."
  },
  "hooks": {
    "enablePrePush": true,
    "enableCommitMsg": true,
    "enablePreCommit": true,
    "preCommitVariant": "lint-test"
  },
  "scripts": {
    "optional": {
      "check": true,
      "clean": true,
      "cover": false,
      "fix": true,
      "security": true,
      "setup": false,
      "type": false,
      "update": true
    }
  },
  "lint": {
    "profile": "standard"
  },
  "workflows": {
    "ci": true,
    "provenance": false,
    "requirePinnedFullSha": true,
    "weeklyUpdate": true
  },
  "claude": {
    "includeSecurityScanSkill": true,
    "includeSharedSkills": true,
    "includeUpdatingSkill": true
  },
  "workspace": {
    "blockExoticSubdeps": true,
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": ["@socketregistry/*", "@socketsecurity/*"],
    "resolutionMode": "highest",
    "trustPolicy": "no-downgrade"
  }
}
